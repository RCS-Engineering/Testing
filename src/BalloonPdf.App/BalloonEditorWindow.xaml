<Window x:Class="BalloonPdf.App.BalloonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BalloonPdf.App"
        Title="Edit Balloons" Height="720" Width="1220" MinHeight="600" MinWidth="1040">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,8">
            <Button MinWidth="90" Margin="0,0,8,0" Content="Previous" Click="PreviousPage_Click" />
            <TextBlock x:Name="PageTextBlock" VerticalAlignment="Center" Margin="0,0,8,0" Text="Page 0 of 0" />
            <Button MinWidth="90" Content="Next" Click="NextPage_Click" />
        </StackPanel>

        <local:PdfPreviewControl x:Name="Preview" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" />

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}" Padding="14">
            <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Balloons" />
                <TextBlock Margin="0,4,0,8" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Select a balloon on the page or in the list, edit its number/color, delete it, or add one by clicking the preview." />
                <ListBox x:Name="AnnotationListBox" Height="220" SelectionChanged="AnnotationListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="#" />
                                <Run Text="{Binding BalloonNumber}" />
                                <Run Text="  Page " />
                                <Run Text="{Binding PageNumber}" />
                                <Run Text="  " />
                                <Run Text="{Binding SourceText}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Selected balloon" />
                <TextBlock x:Name="SelectedTextBlock" Margin="0,0,0,8" Foreground="{StaticResource MutedTextBrush}" Text="No balloon selected." />

                <TextBlock Text="Number" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBox x:Name="NumberTextBox" Margin="0,0,8,0" />
                    <Button MinWidth="90" Content="Apply" Click="ApplyNumber_Click" />
                </StackPanel>

                <TextBlock Text="Color" />
                <ComboBox x:Name="ColorComboBox" Margin="0,4,0,12" SelectionChanged="ColorComboBox_SelectionChanged">
                    <ComboBoxItem Content="Black" Tag="#000000" />
                    <ComboBoxItem Content="Red" Tag="#D00000" />
                    <ComboBoxItem Content="Blue" Tag="#0057D9" />
                    <ComboBoxItem Content="Green" Tag="#008A00" />
                    <ComboBoxItem Content="Orange" Tag="#E07000" />
                </ComboBox>

                <Button x:Name="AddButton" Margin="0,0,0,8" Content="Add balloon by clicking preview" Click="Add_Click" />
                <Button Margin="0,0,0,8" Content="Delete selected" Click="Delete_Click" />
                <TextBlock x:Name="EditorStatusTextBlock" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button MinWidth="100" Margin="0,0,8,0" IsDefault="True" Content="Save" Click="Save_Click" />
            <Button MinWidth="100" IsCancel="True" Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
