<Window x:Class="BalloonPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Balloon PDF" Height="280" Width="720" MinHeight="280" MinWidth="640">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Input PDF" />
        <TextBox x:Name="InputPathTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,10" IsReadOnly="True" />
        <Button Grid.Row="0" Grid.Column="2" Margin="0,0,0,10" MinWidth="96" Content="Browse..." Click="SelectInput_Click" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Output PDF" />
        <TextBox x:Name="OutputPathTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,10" />
        <Button Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" MinWidth="96" Content="Save As..." Click="SelectOutput_Click" />

        <Button x:Name="GenerateButton" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" MinWidth="120" Padding="12,6" Content="Generate" Click="Generate_Click" />

        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0" Padding="10" BorderBrush="#FFCCCCCC" BorderThickness="1">
            <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap" Text="Choose a vector-text engineering PDF to begin." />
        </Border>
    </Grid>
</Window>
