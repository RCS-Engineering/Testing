<Window x:Class="BalloonPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BalloonPdf.App"
        Title="Balloon PDF" Height="720" Width="1040" MinHeight="600" MinWidth="880">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="28,20">
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Foreground="White" Text="Engineering Balloon Generator" />
                <TextBlock Margin="0,4,0,0" FontSize="15" Foreground="#DDEEFF" Text="Automatically Generates Balloon numbers on Drawings as PDF and Inspection Report as Excel having Dimesions" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Margin="0,0,0,12" Padding="18,14"  Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Input PDF" />
                        <TextBox x:Name="InputPathTextBox" Grid.Column="1" Margin="0,0,12,0" IsReadOnly="True" />
                        <Button Grid.Column="2"
        MinWidth="250"
        Click="SelectInput_Click">
                            <TextBlock Text="Browse......."
               Foreground="White"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <Border Margin="0,0,0,12" Padding="18,14" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Output PDF" />
                        <TextBox x:Name="OutputPathTextBox" Grid.Column="1" Margin="0,0,12,0" />
                        <Button Grid.Column="2"
        MinWidth="250"
        Click="SelectOutput_Click">
                            <TextBlock Text="Save As......."
               Foreground="White"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <Border Margin="0,0,0,12" Padding="18,14" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Excel Template" />
                        <TextBox x:Name="ExcelTemplatePathTextBox" Grid.Column="1" Margin="0,0,12,0" />
                        <Button Grid.Column="2"
        MinWidth="250"
        Click="SelectExcelTemplate_Click">
                            <TextBlock Text="Browse......."
               Foreground="White"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <Border Margin="0,0,0,14" Padding="18,14" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Output Excel" />
                        <TextBox x:Name="ExcelOutputPathTextBox" Grid.Column="1" Margin="0,0,12,0" />
                        <Button Grid.Column="2"
        MinWidth="250"
        Click="SelectExcelOutput_Click">
                            <TextBlock Text="Save As......."
               Foreground="White"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Padding="16" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center">

                    <Button x:Name="GenerateButton"
                            MinWidth="128"
                            Margin="0,0,10,0"
                            Content="Generate"
                            Click="Generate_Click" />

                    <Button x:Name="ExpandEditButton"
                            MinWidth="128"
                            Margin="0,0,10,0"
                            Content="Expand/Edit"
                            IsEnabled="False"
                            Click="ExpandEdit_Click" />

                    <Button x:Name="OpenPdfButton"
                            MinWidth="128"
                            Margin="0,0,10,0"
                            Content="Open PDF"
                            IsEnabled="False"
                            Click="OpenPdf_Click" />

                    <Button x:Name="OpenExcelButton"
                            MinWidth="128"
                            Content="Open Excel"
                            IsEnabled="False"
                            Click="OpenExcel_Click" />

                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,16,0,0" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10">
                <local:PdfPreviewControl x:Name="InlinePreview" />
            </Border>

            <Border Grid.Row="3" Margin="0,12,0,0" Padding="14" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10">
                <TextBlock x:Name="StatusTextBlock" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Choose a vector-text engineering PDF to begin." />
            </Border>
        </Grid>
    </Grid>
</Window>
